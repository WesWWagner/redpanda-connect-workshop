# Site A (Fab)
SITE_A_BROKER=seed-xxxxx.xxx.fmc.prd.cloud:9092
SITE_A_USER=workshop-user
SITE_A_PASSWORD=changeme

# Site B (Fab)
SITE_B_BROKER=seed-yyyyy.yyy.fmc.prd.cloud:9092
SITE_B_USER=workshop-user
SITE_B_PASSWORD=changeme

# Central IT
CENTRAL_BROKER=seed-zzzzz.zzz.fmc.prd.cloud:9092
CENTRAL_USER=workshop-user
CENTRAL_PASSWORD=changeme

# Student ID — use your name or initials (no spaces)
# Used to namespace your consumer groups so they don't conflict
STUDENT_ID=alice

# Postgres (Lab 2)
PG_HOST=postgres.workshop.internal
PG_PORT=5432
PG_DB=workshop
PG_USER=workshop
PG_PASSWORD=changeme

# Lab 2 only, and OPTIONAL: a trial license already ships in the repo as
# workshop/redpanda.license and the workbench mounts it automatically, so you
# normally leave this blank. Set it only to override the bundled license with
# your own key.
REDPANDA_LICENSE=
